{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff --stat)",
      "Bash(git diff --name-only)",
      "Bash(git diff --name-status)",
      "Bash(git log --oneline)",
      "Bash(git show --stat)",
      "Bash(git show --no-patch)",
      "Bash(git rev-parse *)",
      "Bash(git worktree list *)",
      "Bash(git merge-base *)",
      "Bash(git merge-tree *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(./scripts/verify.sh)",
      "Bash(./scripts/verify.sh *)",
      "Bash(./gate.sh)",
      "Bash(./gate.sh *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git clean *)",
      "Bash(git reset --hard *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
